PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/daybook?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=replace_with_32_byte_secret_hex_or_string
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SAMESITE=lax
SEND_ENABLED=false

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Integrations
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

MICROSOFT_CLIENT_ID=your_azure_ad_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_ad_app_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
